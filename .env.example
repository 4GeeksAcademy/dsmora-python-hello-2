# Copy to .env and fill in your own keys — NEVER commit the real .env.
# The RFP pipeline's optional LLM backend reads these via
# agentic_workflow_example/rfp_pipeline/llm.py (stdlib urllib, no SDK needed).

# 4Geeks LLM gateway (OpenAI-compatible)
LLM_API_URL=https://llm.4geeks.ai/v1
LLM_MODEL=madrid-spain/opnerouter/openai/gpt-6-luna
LLM_API_KEY=sk-your-key-here

# Set to 1 to activate the LLM path. Leave unset/0 for the fully
# deterministic, offline generator (what the unit tests always use).
RFP_USE_LLM=1

# ---------------------------------------------------------------------------
# Extra vars from the 4Geeks starter template (not used by this pipeline yet,
# kept for reference).
# ---------------------------------------------------------------------------
EMBEDDING_API_URL=https://llm.4geeks.ai/v1
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
EMBEDDING_API_KEY=

MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=authenticated
MCP_RESOURCE_URL=http://localhost:8000/mcp
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000